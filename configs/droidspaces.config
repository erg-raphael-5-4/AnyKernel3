# Droidspaces (https://github.com/ravindu644/Droidspaces-OSS) container
# support, merged on top of the rooted config by build-droidspaces.sh.
#
# Only options this 5.4 tree is missing are listed. The kernel has no
# loadable modules, so the GKI kABI patches from the Droidspaces docs are
# not needed. CONFIG_FAIR_GROUP_SCHED is left off on purpose: it changes
# how Android's cpu cgroups share CPU time between app groups.

# IPC and namespaces (required)
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
# Unprivileged user namespaces, for Docker inside a container
CONFIG_USER_NS=y

# cgroups
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# CONFIG_CGROUP_NET_PRIO is left off: net_prio in this tree still reads
# cgroup->id, which a backport removed, so it does not build.
CONFIG_CGROUP_NOPREFIX_LINKS=y

# /dev for containers (not mounted on the host)
CONFIG_DEVTMPFS=y

# tmpfs ACLs and xattrs (NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

CONFIG_FW_LOADER_COMPRESS=y

# NAT networking
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES=y
# conntrack netlink (NF_CONNTRACK_NETLINK in the Droidspaces docs) is
# CONFIG_NF_CT_NETLINK here and already enabled
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# UFW / Fail2ban inside a container
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
